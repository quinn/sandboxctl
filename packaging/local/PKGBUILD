pkgname=sandboxctl-local
pkgver=0.1.0.r96.gf919917
pkgrel=1
pkgdesc='Manage local Firecracker development sandboxes'
arch=('x86_64')
url='https://github.com/quinn/sandboxctl'
license=('AGPL-3.0-or-later' 'Apache-2.0' 'BSD-2-Clause' 'BSD-3-Clause' 'ISC' 'MIT' 'MPL-2.0')
depends=('e2fsprogs' 'iproute2' 'nftables' 'openssh')
makedepends=('cpio' 'curl' 'git' 'go>=1.27' 'gzip' 'podman' 'python' 'squashfs-tools')
provides=('sandboxctl')
conflicts=('sandboxctl' 'sandboxctl-git')
_firecracker_version=1.17.0
_firecracker_arch=x86_64
source=(
	"firecracker-v${_firecracker_version}-${_firecracker_arch}.tgz::https://github.com/firecracker-microvm/firecracker/releases/download/v${_firecracker_version}/firecracker-v${_firecracker_version}-${_firecracker_arch}.tgz"
)
sha256sums=('06094a1108ae9e82aa4c23a775aa92758f53f1175d422270d9d6162cb9ade558')

find_builder_bundle() {
	local images_dir="$1"
	local manifest image_name version bundle artifact valid
	[[ -d $images_dir ]] || return 0
	while IFS= read -r -d '' manifest; do
		image_name=$(basename "$(dirname "$(dirname "$manifest")")")
		case "$image_name" in
			builder|builder-*) ;;
			*) continue ;;
		esac
		version=$(basename "$(dirname "$manifest")")
		[[ $version == sha256:* ]] || continue
		bundle=$(dirname "$manifest")
		valid=1
		for artifact in vmlinux initramfs.cpio.gz root.squashfs; do
			if [[ ! -s $bundle/$artifact || -L $bundle/$artifact ]]; then
				valid=0
				break
			fi
		done
		[[ $valid == 1 ]] || continue
		printf '%s\n' "$bundle"
		return 0
	done < <(find "$images_dir" -mindepth 3 -maxdepth 3 -type f -name manifest.json -print0)
}

pkgver() {
	local project_root="$startdir/../.."
	local count hash
	count=$(git -C "$project_root" rev-list --count HEAD)
	hash=$(git -C "$project_root" rev-parse --short=7 HEAD)
	printf '0.1.0.r%s.g%s\n' "$count" "$hash"
}

prepare() {
	local project_root="$startdir/../.."
	mkdir -p "$srcdir/sandboxctl"
	git -C "$project_root" ls-files --cached --others --exclude-standard -z > "$srcdir/source-files"
	tar -C "$project_root" --null --files-from="$srcdir/source-files" -cf - |
		tar -C "$srcdir/sandboxctl" -xf -
	rm "$srcdir/source-files"
}

build() {
	cd "$srcdir/sandboxctl"
	make build
	local package_images="$srcdir/package-data/sandboxctl/images"
	local package_bundle cached_bundle data_home
	package_bundle=$(find_builder_bundle "$package_images")
	if [[ -n $package_bundle ]]; then
		printf 'Using the builder image already in the package build directory: %s\n' "$package_bundle"
		return
	fi
	data_home=${XDG_DATA_HOME:-"$HOME/.local/share"}
	cached_bundle=$(find_builder_bundle "$data_home/sandboxctl/images")
	if [[ -n $cached_bundle ]]; then
		local image_name version destination
		image_name=$(basename "$(dirname "$(dirname "$cached_bundle")")")
		version=$(basename "$(dirname "$cached_bundle")")
		destination="$package_images/$image_name/$version"
		install -d -m700 "${destination%/*}"
		cp -a "$cached_bundle" "$destination"
		printf 'Copied the staged builder image into the package build directory: %s\n' "$destination"
		return
	fi
	XDG_DATA_HOME="$srcdir/package-data" IMAGE_NAME=auto make stage-builder-image
}

package() {
	cd "$srcdir/sandboxctl"
	local firecracker_dir="$srcdir/release-v${_firecracker_version}-${_firecracker_arch}"
	local builder_bundle builder_manifest
	builder_bundle=$(find_builder_bundle "$srcdir/package-data/sandboxctl/images")
	if [[ -z $builder_bundle ]]; then
		printf 'The builder image bundle was not created during package build.\n' >&2
		return 1
	fi
	builder_manifest="$builder_bundle/manifest.json"
	install -Dm755 bin/sandboxctl "$pkgdir/usr/bin/sandboxctl"
	install -Dm755 bin/sandboxd "$pkgdir/usr/bin/sandboxd"
	install -Dm755 "$firecracker_dir/firecracker-v${_firecracker_version}-${_firecracker_arch}" "$pkgdir/usr/lib/sandboxctl/firecracker"
	install -Dm755 "$firecracker_dir/jailer-v${_firecracker_version}-${_firecracker_arch}" "$pkgdir/usr/lib/sandboxctl/jailer"
	for executable in bin/sandboxctl-*; do
		install -Dm755 "$executable" "$pkgdir/usr/bin/${executable##*/}"
	done
	install -Dm644 packaging/systemd/sandboxd.socket "$pkgdir/usr/lib/systemd/system/sandboxd.socket"
	install -Dm644 packaging/systemd/sandboxd.service "$pkgdir/usr/lib/systemd/system/sandboxd.service"
	install -d -m755 "$pkgdir/usr/share/sandboxctl/builder"
	install -m644 "$builder_bundle/manifest.json" "$pkgdir/usr/share/sandboxctl/builder/manifest.json"
	install -m644 "$builder_bundle/vmlinux" "$pkgdir/usr/share/sandboxctl/builder/vmlinux"
	install -m644 "$builder_bundle/initramfs.cpio.gz" "$pkgdir/usr/share/sandboxctl/builder/initramfs.cpio.gz"
	install -m644 "$builder_bundle/root.squashfs" "$pkgdir/usr/share/sandboxctl/builder/root.squashfs"
	install -Dm644 README.md "$pkgdir/usr/share/doc/sandboxctl/README.md"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -d "$pkgdir/usr/share/licenses/$pkgname/third_party"
	cp -a third_party/licenses/. "$pkgdir/usr/share/licenses/$pkgname/third_party/"
}
