[Unit]
Description=sandboxctl privileged control service
Requires=sandboxd.socket
After=sandboxd.socket

[Service]
Type=simple
ExecStart=/usr/bin/sandboxd --systemd-socket
Restart=on-failure
RestartSec=1s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
ReadWritePaths=/var/lib/sandboxctl
